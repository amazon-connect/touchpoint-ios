      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be uploaded."
          }
        }
      }
    },
    "touchpoint.attachment.uploaded": {
      "comment": "VoiceOver announcement: the picked file reached the agent.",
