    "touchpoint.attachment.delete": {
      "comment": "Accessibility label: removes the picked file from the composer (web: Delete).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "touchpoint.attachment.generic": {
      "comment": "Composer error: the file could not be read or is a type Connect does not accept (web copy).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        }
      }
    },
    "touchpoint.attachment.label": {
      "comment": "Accessibility label for a file in the transcript. %@ is the file name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachment, %@"
          }
        }
      }
    },
    "touchpoint.attachment.openFailed": {
      "comment": "VoiceOver announcement: an attachment from the agent could not be downloaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be opened."
          }
        }
      }
    },
    "touchpoint.attachment.tooBig": {
      "comment": "Composer error: the picked file is over the size limit. %d is the limit in megabytes (web copy).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too big. Max file size: %dmb"
          }
        }
      }
    },
    "touchpoint.attachment.upload": {
      "comment": "Accessibility label: composer button that picks a file to send to the agent (web: Upload file).",
