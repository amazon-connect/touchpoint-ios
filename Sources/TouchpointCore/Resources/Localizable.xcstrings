    "touchpoint.authentication.lockedHint": {
      "comment": "Composer placeholder while sign-in is pending (web authentication.lockedInputHint).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte die Authentifizierung abschließen oder überspringen, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete or skip authentication before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa u omite la autenticación antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez ou ignorez l'authentification avant de continuer."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez ou ignorez l'authentification avant de continuer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan atau lewati autentikasi sebelum melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa o salta l'autenticazione prima di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行する前に認証を完了またはスキップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하기 전에 인증을 완료하거나 건너뛰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua ou ignore a autenticação antes de continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成或跳过身份验证，然后再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先完成或略過驗證，然後再繼續。"
          }
        }
      }
    },
