{
  "sourceLanguage": "en",
  "strings": {
    "touchpoint.action.close": {
      "comment": "Accessibility label for the button that dismisses the chat sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "touchpoint.action.closeSettings": {
      "comment": "Accessibility label for the header button that closes the open settings panel (web: \"Close settings\").",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close settings"
          }
        }
      }
    },
    "touchpoint.action.copy": {
      "comment": "Accessibility label for the button that copies an assistant message to the clipboard.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy message"
          }
        }
      }
    },
    "touchpoint.action.loadEarlier": {
      "comment": "Button that pages further back in the transcript.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load earlier messages"
          }
        }
      }
    },
    "touchpoint.action.microphone": {
      "comment": "Accessibility label for the composer's microphone button, which starts voice mode.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak"
          }
        }
      }
    },
    "touchpoint.action.minimise": {
      "comment": "Accessibility label for a control that minimises an assistant surface — the docked chat panel, or the full-screen call — which stays available (the call keeps running).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimise"
          }
        }
      }
    },
    "touchpoint.action.restart": {
      "comment": "Accessibility label for the header button that starts a new conversation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start over"
          }
        }
      }
    },
    "touchpoint.action.retry": {
      "comment": "Button that retries a message that could not be delivered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "touchpoint.action.settings": {
      "comment": "Accessibility label for the header button that opens the host's settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "touchpoint.action.startNewConversation": {
      "comment": "Button that replaces the message field once a conversation has ended, and starts a new one.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Unterhaltung starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start new conversation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar nueva conversación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer une nouvelle conversation"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer une nouvelle conversation"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai percakapan baru"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia nuova conversazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい会話を開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 대화 시작"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar nova conversa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始新对话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始新對話"
          }
        }
      }
    },
    "touchpoint.action.thumbsDown": {
      "comment": "Accessibility label for the negative feedback button under an assistant message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poor response"
          }
        }
      }
    },
    "touchpoint.action.thumbsUp": {
      "comment": "Accessibility label for the positive feedback button under an assistant message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good response"
          }
        }
      }
    },
