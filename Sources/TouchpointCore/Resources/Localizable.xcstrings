      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload file"
          }
        }
      }
    },
    "touchpoint.attachment.uploadFailed": {
      "comment": "Composer error: Connect did not accept the file (web copy).",
