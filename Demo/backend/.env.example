# Copy to .env and fill in. None of these is a secret; .env is gitignored.

# Your Amazon Connect instance (Connect console > instance > Distribution settings / the ARN's last part)
INSTANCE_ID=00000000-0000-0000-0000-000000000000
# The instance's Region. Agentic CX Designer and Live Sync must be available there.
AWS_REGION=us-west-2
# Optional: the instance's URL, used to fill the demo apps' connectInstanceUrl
CONNECT_INSTANCE_URL=https://your-instance-alias.my.connect.aws
# Optional: a named AWS CLI profile; otherwise your default credentials are used
# AWS_PROFILE=my-profile
